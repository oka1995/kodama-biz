{
  "name": "ana-availability-checker",
  "version": "0.2.0",
  "private": true,
  "description": "ANA国際線 空席待ち人数 自動照会ツール（ローカルWebサーバ／スマホ対応）",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "doctor": "node -e \"import('./src/automate.js').then(m=>m.doctor()).then(r=>{console.log(r); process.exit(r.ok?0:1)})\"",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
